description=OpenSSL wrapper (encryption)

# NOTE: use HB_STATIC_OPENSSL=yes envvar to link openssl lib statically

incpaths=.

headers=${hb_name}.ch

skip={dos}

{!HB_DYNBIND_OPENSSL&!(HB_STATIC_OPENSSL&!hbdyn)}libs=${_HB_DYNPREF}${hb_name}
{!HB_DYNBIND_OPENSSL& (HB_STATIC_OPENSSL&!hbdyn)}libs=${_HB_DYNPREF}${hb_name}s

{!HB_DYNBIND_OPENSSL&unix}libs=ssl crypto
{!HB_DYNBIND_OPENSSL&os2}libs=libssl_s libcrypto_s
{!HB_DYNBIND_OPENSSL&win&!allmingw&!allmsvc&!clang&!zig}libs=ssleay32 libeay32
{!HB_DYNBIND_OPENSSL&allmsvc&HB_COMP_VER<'1910'}libs=ssleay32 libeay32
{!HB_DYNBIND_OPENSSL&win&(allmingw|clang|zig)}libs=ssl crypto bcrypt
{!HB_DYNBIND_OPENSSL&allmsvc&HB_COMP_VER>'1909'}libs=libssl libcrypto
{!HB_DYNBIND_OPENSSL&allwin}libs=crypt32

{HB_STATIC_OPENSSL&!hbdyn&win&(allmingw|clang|zig)}libpaths=${HB_WITH_OPENSSL}\..\lib
{HB_STATIC_OPENSSL&!hbdyn&win&(allmingw|clang|zig)}libs=ssl crypto bcrypt 
{HB_STATIC_OPENSSL&!hbdyn&win&!allmingw&!clang&!zig}libs=libssl libcrypto libbcrypt
